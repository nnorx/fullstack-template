# Cloudflare Tunnel configuration example
# See: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/
#
# Setup steps:
# 1. Install cloudflared: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/
# 2. Authenticate: cloudflared tunnel login
# 3. Create tunnel: cloudflared tunnel create fullstack-template
# 4. Add DNS: cloudflared tunnel route dns fullstack-template yourdomain.com
# 5. Set TUNNEL_TOKEN in your .env file (from the Cloudflare dashboard)
#
# For Docker Compose deployment, the tunnel is configured via the TUNNEL_TOKEN
# environment variable and runs as a service in docker-compose.yml.
# Enable it with: docker compose --profile tunnel up -d
#
# Manual configuration (alternative to token-based):
tunnel: <your-tunnel-id>
credentials-file: /root/.cloudflared/<your-tunnel-id>.json

ingress:
  - hostname: yourdomain.com
    service: http://caddy:80
  - service: http_status:404
