# ========================================
# Development Settings (pnpm dev)
# ========================================

# Database (local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_template

# Better Auth
# SECURITY: Generate a strong secret with: openssl rand -base64 32
# NEVER commit the real secret to version control!
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3001

# Frontend origin (trusted by Better Auth for CORS/CSRF)
FRONTEND_URL=http://localhost:5173

# API
API_PORT=3001

# Frontend (Vite - must be prefixed with VITE_)
VITE_API_URL=http://localhost:3001

# ========================================
# Production Settings (docker-compose.yml)
# ========================================
# Uncomment and set these when deploying with docker-compose

# PostgreSQL credentials
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me-in-production
# POSTGRES_DB=fullstack_template

# Database connection (use 'db' as host for Docker networking)
# DATABASE_URL=postgresql://postgres:your-password@db:5432/fullstack_template

# URLs for production (use your actual domain with HTTPS)
# BETTER_AUTH_URL=https://yourdomain.com
# FRONTEND_URL=https://yourdomain.com

# Cloudflare Tunnel (optional - only if using --profile tunnel)
# Get token from: https://one.dash.cloudflare.com/
# TUNNEL_TOKEN=your-tunnel-token
