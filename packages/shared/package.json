{
	"name": "@fullstack-template/shared",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		}
	},
	"scripts": {
