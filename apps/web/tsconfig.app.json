{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./.cache/tsconfig.app.tsbuildinfo",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],

		/* Path aliases */
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},

		/* Bundler mode */
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"jsx": "react-jsx"
	},
	"include": ["src"]
}
