# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_template

# Better Auth
# SECURITY: Generate a strong secret with: openssl rand -base64 32
# NEVER commit the real secret to version control!
BETTER_AUTH_SECRET=your-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3001

# Frontend origin (trusted by Better Auth for CORS/CSRF)
FRONTEND_URL=http://localhost:5173

# API
API_PORT=3001

# Frontend (Vite - must be prefixed with VITE_)
VITE_API_URL=http://localhost:3001

# Production-only (for docker-compose.yml)
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me-in-production
# POSTGRES_DB=fullstack_template
