# ========================================
# Development Settings (pnpm dev)
# ========================================

# Database (local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_template

# Better Auth
# SECURITY: Generate a strong secret with: openssl rand -base64 32
# Must be at least 32 characters. NEVER commit the real secret to version control!
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Frontend origin (trusted by Better Auth for CORS/CSRF)
FRONTEND_URL=http://localhost:5173

# API
API_PORT=3001

# Frontend (Vite - must be prefixed with VITE_)
VITE_API_URL=http://localhost:3001

# ========================================
# Observability (Sentry) — optional
# ========================================
# Create projects at https://sentry.io and paste DSNs here.
# When unset, Sentry is disabled and the app runs without any observability overhead.

# Backend (Hono/Node.js project DSN)
# SENTRY_DSN=https://...@o....ingest.us.sentry.io/...

# Frontend (React project DSN — must be prefixed with VITE_)
# VITE_SENTRY_DSN=https://...@o....ingest.us.sentry.io/...

# Source map uploads (CI/CD only — keep secret!)
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-org
# SENTRY_PROJECT_WEB=your-web-project

# ========================================
# Production Settings (docker-compose.yml)
# ========================================
# Uncomment and set these when deploying with docker-compose

# PostgreSQL credentials
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me-in-production
# POSTGRES_DB=fullstack_template

# Database connection (use 'db' as host for Docker networking)
# DATABASE_URL=postgresql://postgres:your-password@db:5432/fullstack_template

# URLs for production (use your actual domain with HTTPS)
# BETTER_AUTH_URL=https://yourdomain.com
# FRONTEND_URL=https://yourdomain.com

# Cloudflare Tunnel (optional - only if using --profile tunnel)
# Get token from: https://one.dash.cloudflare.com/
# TUNNEL_TOKEN=your-tunnel-token
